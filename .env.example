# Prefix every runtime setting with RVA_. Replace CHANGE_ME before use.
# Do not commit a real .env file.

RVA_ENV=dev
RVA_LOG_LEVEL=INFO
RVA_DASHBOARD_TOKEN=CHANGE_ME
RVA_STT_URL=CHANGE_ME
RVA_LLM_URL=CHANGE_ME
RVA_TTS_URL=CHANGE_ME
RVA_COLAB_URL=CHANGE_ME
RVA_COLAB_TOKEN=CHANGE_ME
RVA_VAD_RMS_THRESHOLD=500
RVA_VAD_HANGOVER_FRAMES=4
RVA_VAD_MIN_SPEECH_FRAMES=2
RVA_VAD_SAMPLE_RATE=16000
