# Prefix every runtime setting with RVA_. Replace CHANGE_ME before use.
# Do not commit a real .env file.

RVA_ENV=dev
RVA_LOG_LEVEL=INFO
RVA_DASHBOARD_TOKEN=CHANGE_ME
RVA_STT_BACKEND=mock
RVA_LLM_BACKEND=mock
RVA_TTS_BACKEND=mock
RVA_STT_URL=CHANGE_ME
RVA_LLM_URL=CHANGE_ME
RVA_TTS_URL=CHANGE_ME
RVA_STT_TOKEN=CHANGE_ME
RVA_LLM_TOKEN=CHANGE_ME
RVA_TTS_TOKEN=CHANGE_ME
RVA_STT_MODEL=rva-stt
RVA_LLM_MODEL=rva-llm
RVA_TTS_MODEL=rva-tts
RVA_HTTP_TIMEOUT=10
RVA_COLAB_URL=CHANGE_ME
RVA_COLAB_TOKEN=CHANGE_ME
RVA_VAD_RMS_THRESHOLD=500
RVA_VAD_HANGOVER_FRAMES=4
RVA_VAD_MIN_SPEECH_FRAMES=2
RVA_VAD_SAMPLE_RATE=16000
# Bind 0.0.0.0 so Asterisk in Docker (host-gateway) can reach the agent.
# SIP stays on 127.0.0.1:5060.
RVA_AUDIOSOCKET_HOST=0.0.0.0
RVA_AUDIOSOCKET_PORT=8090
